# systemd 守护 cloudflared（放到 /etc/systemd/system/cloudflared.service）
# sudo cp cloudflared.service /etc/systemd/system/
# sudo systemctl daemon-reload && sudo systemctl enable --now cloudflared
[Unit]
Description=Cloudflare Tunnel for fireflyiv.com
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/cloudflared --config /etc/cloudflared/config.yml tunnel run fireflyiv
Restart=on-failure
RestartSec=5
User=root
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target