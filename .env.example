# 站点 URL（构建时用于 RSS/sitemap 的绝对地址）
SITE_URL=https://www.fireflyiv.com

# chatter 发布接口鉴权 token（生产必改）
CHATTER_TOKEN=change-me-to-a-long-random-string

# 评论服务地址（Artalk，浏览器端可见；未配置则文章页不渲染评论区）
NEXT_PUBLIC_ARTALK_SERVER=https://talk.fireflyiv.com
# 运行时 Artalk 服务地址（仅服务端/反向代理使用，通常同上）
ARTALK_SERVER=https://talk.fireflyiv.com

# 友链申请防刷（两项都留空时自动关闭）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
